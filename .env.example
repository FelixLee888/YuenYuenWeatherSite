PORT=4173

# Optional: send added watchlist locations to Yuen Yuen AIBot.
# Leave empty to keep watchlist updates local only.
AIBOT_WATCHLIST_SYNC_URL=
AIBOT_SYNC_TIMEOUT_MS=5000

# Google Sheets external weather DB (optional for local server/scripts).
GOOGLE_SHEETS_ENABLED=1
GOOGLE_SHEETS_SPREADSHEET_ID=1g9_1I1xyt7iO922yNXckPswnqV5ATIzLo3NQ6IJ4O5k
# Preferred credential option:
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional direct OAuth bearer token (advanced/manual use):
GOOGLE_OAUTH_ACCESS_TOKEN=
# Alternative option (if not using GOOGLE_SERVICE_ACCOUNT_JSON):
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Admin watchlist management via Google login.
# Use a Google OAuth client from the weather-ai-bot-488422 project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_ALLOWED_EMAILS=jancefelix@gmail.com
# Optional explicit session signing secret. If empty, the server derives one
# from the Google service-account credentials.
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_MS=604800000
ADMIN_OAUTH_STATE_TTL_MS=600000

# Optional upstream weather provider credentials.
# Set these if you want refresh runs to include the extra model sources.
OPENWEATHER_API_KEY=
GOOGLE_WEATHER_ACCESS_TOKEN=
GOOGLE_WEATHER_API_KEY=
